# Step 3: Harek column integer ho ki haina check garne
for (col in names(bagmati)) {
  x <- bagmati[[col]]
  if (is.numeric(x)) {
    whole <- all(x == round(x), na.rm = TRUE)   # sabai value purna sankhya ho ki nai
    cat(col, "| class:", class(x), "| typeof:", typeof(x),
        "| sabai purna sankhya?:", whole, "\n")
  } else {
    cat(col, "| class:", class(x), "(text, number haina)\n")
  }
}

