# STEP 5: Khali (NA) value kati xa check garne
# =========================================================
cat("DBH_cm ma NA:", sum(is.na(bagmati$DBH_cm)), "\n")       # DBH napna nasakeko kati wota
cat("Height_m ma NA:", sum(is.na(bagmati$Height_m)), "\n")   # height napna nasakeko kati wota


# =========================================================
# STEP 6: Negative number xa ki xaina check garne
# (rukh ko DBH ra height kahile pani negative hunna)
# =========================================================

# DBH ma negative kati wota xa
cat("DBH_cm ma negative:", sum(bagmati$DBH_cm < 0, na.rm = TRUE), "\n")

# DBH ma zero kati wota xa (zero pani hunu mildaina)
cat("DBH_cm ma zero:", sum(bagmati$DBH_cm == 0, na.rm = TRUE), "\n")

# Height ma negative kati wota xa
cat("Height_m ma negative:", sum(bagmati$Height_m < 0, na.rm = TRUE), "\n")


# =========================================================
# STEP 7: Negative bhayeko row haru dekhaune
# =========================================================

# DBH negative bhayeko rukh haru
neg_dbh <- which(bagmati$DBH_cm < 0)    # kun kun row ma DBH negative xa
cat("DBH negative bhayeko row number:", neg_dbh, "\n")
print(bagmati[neg_dbh, c("Plot_ID", "Tree_ID", "Species", "DBH_cm", "Height_m")])

# Height negative bhayeko rukh haru
neg_height <- which(bagmati$Height_m < 0)   # kun kun row ma height negative xa
cat("Height negative bhayeko row number:", neg_height, "\n")
print(bagmati[neg_height, c("Plot_ID", "Tree_ID", "Species", "DBH_cm", "Height_m")])


# =========================================================
# STEP 8: -99 ra 999 code kati wota xa check garne
# (-99 ra 999 = field ma napna nasakeko code, sacho value haina)
# =========================================================
cat("DBH_cm == -99:", sum(bagmati$DBH_cm == -99, na.rm = TRUE), "\n")
cat("DBH_cm == 999:", sum(bagmati$DBH_cm == 999, na.rm = TRUE), "\n")
cat("Height_m == -99:", sum(bagmati$Height_m == -99, na.rm = TRUE), "\n")


# =========================================================
# STEP 9: Dohoriyeko (duplicate) rukh check garne
# =========================================================
dup <- duplicated(bagmati[, c("Plot_ID", "Tree_ID")])   # eutai plot ma eutai tree ID dui choti xa ki
cat("Duplicate rows:", sum(dup), "\n")
print(bagmati[dup, c("Plot_ID", "Tree_ID", "DBH_cm", "Height_m")]) 





